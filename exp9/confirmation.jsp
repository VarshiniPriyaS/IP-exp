<!DOCTYPE html>
<html>

<head>

    <title>Order Confirmed</title>

    <style>

        body {
            margin: 0;
            background: #f4f6f8;
            font-family: Arial, sans-serif;
        }

        .success {
            width: 450px;
            margin: 100px auto;
            background: white;
            padding: 45px;
            text-align: center;
            border-radius: 16px;
            box-shadow: 0 8px 25px rgba(0,0,0,0.1);
        }

        .success h1 {
            margin-bottom: 15px;
        }

        .success p {
            color: #666;
        }

        a {
            display: inline-block;
            margin: 10px;
            padding: 11px 20px;
            background: #222;
            color: white;
            text-decoration: none;
            border-radius: 7px;
        }

    </style>

</head>

<body>

<div class="success">

    <h1>Order Confirmed!</h1>

    <p>
        Your order has been placed successfully.
    </p>

    <a href="catalog.jsp">
        Continue Shopping
    </a>

    <a href="orderHistory.jsp">
        View Orders
    </a>

</div>

</body>
</html>